# Core credentials
OPENAI_API_KEY=
MONGODB_URI=
API_KEY=
WEBHOOK_KEY=

# Discord: non-production runs prefer the testing token automatically.
DISCORD_TESTING_TOKEN=
DISCORD_TOKEN=
DISCORD_TOKEN_PROD=

# Runtime
NODE_ENV=development
PORT=8940
VERSION=2.0.0
MONGODB_TLS=
# Retry Atlas SRV lookups over HTTPS when local UDP DNS is blocked.
MONGODB_DOH_FALLBACK=true
API_RATE_LIMIT_PER_MINUTE=120
DISCORD_RESPONSES_PER_MINUTE=10
IMAGE_COOLDOWN_MS=120000
API_MAX_BODY_BYTES=3145728
ROLL20_UPLOAD_MAX_BYTES=2097152

# OpenAI models
GLOBAL_GPT_MODEL=gpt-5.6-terra
ALLOWED_USER_GPT_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
STRICT_ALLOWED_MODELS=false
FACT_EXTRACTOR_MODEL=gpt-5.6-luna
SUMMARY_MODEL=gpt-5.6-luna
CLASSIFIER_MODEL=gpt-5.6-luna
MENTAL_HEALTH_CLASSIFIER_MODEL=gpt-5.6-luna
WEBHOOK_REPORT_MODEL=gpt-5.6-luna
IMAGE_GENERATION_MODEL=gpt-image-2
TOKEN_INPUT_LIMIT=12000
TOKEN_OUTPUT_LIMIT=1200
TOKEN_IMAGE_ANALYSIS_LIMIT=1000
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=30000

# Privacy defaults
MEMORY_DEFAULT_ENABLED=false
MEMORY_ENABLED=true
FACT_CONFIDENCE_MIN=0.75

# Optional classifier service
CLASSIFIER_API_URL=http://localhost:8000
CLASSIFIER_API_KEY=
CLASSIFIER_TIMEOUT=5000
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# Optional image analysis
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
VISION_TIMEOUT_MS=15000

# Optional operations
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SIR_MODE_REQUIRED_USER_IDS=
SIR_MODE_INTERVAL_MS=60000
